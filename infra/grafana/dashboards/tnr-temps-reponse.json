          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH versions AS (\n    SELECT version_app, row_number() OVER (ORDER BY min(horodatage) DESC) AS rang\n    FROM tnr.v_mesures_perf WHERE app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures AND version_app IS NOT NULL\n    GROUP BY version_app\n  ), med AS (\n    SELECT v.rang, m.version_app, m.motcle, percentile_cont(0.5) WITHIN GROUP (ORDER BY m.temps_ux_ms) AS ux\n    FROM tnr.v_mesures_perf m JOIN versions v USING (version_app)\n    WHERE app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures AND v.rang <= 2\n    GROUP BY 1, 2, 3\n  ), comp AS (\n    SELECT a.motcle, b.version_app AS v_prec, a.version_app AS v_act, b.ux AS ux_prec, a.ux AS ux_act\n    FROM med a JOIN med b ON a.motcle = b.motcle AND a.rang = 1 AND b.rang = 2\n  )\n  SELECT motcle AS \"Mot-clé\", v_prec AS \"Version précédente\", round(ux_prec::numeric) AS \"UX p50 avant\",\n         v_act AS \"Version actuelle\", round(ux_act::numeric) AS \"UX p50 après\",\n         round((100 * (ux_act / ux_prec - 1))::numeric) AS \"Dérive %\"\n  FROM comp ORDER BY 6 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
