    {
      "id": 5,
      "type": "stat",
      "title": "Part serveur",
      "description": "POST / UX : proche de 100 % = le temps est passé côté serveur",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
