      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT min(horodatage) AS time,\n         round(percentile_cont(0.5)  WITHIN GROUP (ORDER BY temps_ux_ms))   AS \"UX p50\",\n         round(percentile_cont(0.95) WITHIN GROUP (ORDER BY temps_ux_ms))   AS \"UX p95\",\n         round(percentile_cont(0.5)  WITHIN GROUP (ORDER BY temps_post_ms)) AS \"POST p50\"\n  FROM tnr.v_mesures_perf WHERE $__timeFilter(horodatage) AND app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures\n  GROUP BY run_id, machine ORDER BY 1"
        }
      ],
