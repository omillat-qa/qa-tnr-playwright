    {
      "id": 9,
      "type": "table",
      "title": "Par version",
      "description": "Version « inconnue » : runs antérieurs à la lecture de la version (19/10/2026)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
