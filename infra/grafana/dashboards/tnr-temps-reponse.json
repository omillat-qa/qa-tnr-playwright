          "rawSql": "SELECT nom AS \"Mesure\", coalesce(version_app, 'inconnue') AS \"Version\", count(*) AS \"Mesures\",\n         round(percentile_cont(0.5)  WITHIN GROUP (ORDER BY duree_ms)) AS \"p50\",\n         round(percentile_cont(0.95) WITHIN GROUP (ORDER BY duree_ms)) AS \"p95\",\n         max(duree_ms) AS \"max\", min(horodatage) AS \"Première mesure\"\n  FROM tnr.v_mesures_chargement WHERE $__timeFilter(horodatage) AND app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring})\n  GROUP BY nom, version_app ORDER BY nom, min(horodatage) DESC"
