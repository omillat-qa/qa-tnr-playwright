            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * sum(temps_post_ms) / nullif(sum(temps_ux_ms), 0)) AS \"Part serveur\"\n  FROM tnr.v_mesures_perf WHERE $__timeFilter(horodatage) AND app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures"
