        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(version_app, 'inconnue') AS \"Version\", min(build_app) AS \"Build\",\n         count(DISTINCT run_id) AS \"Runs\", count(*) AS \"Mesures\",\n         round(percentile_cont(0.5)  WITHIN GROUP (ORDER BY temps_ux_ms))   AS \"UX p50\",\n         round(percentile_cont(0.95) WITHIN GROUP (ORDER BY temps_ux_ms))   AS \"UX p95\",\n         max(temps_ux_ms) AS \"UX max\",\n         round(percentile_cont(0.5)  WITHIN GROUP (ORDER BY temps_post_ms)) AS \"POST p50\",\n         round(percentile_cont(0.95) WITHIN GROUP (ORDER BY temps_post_ms)) AS \"POST p95\",\n         min(horodatage) AS \"Première mesure\", max(horodatage) AS \"Dernière mesure\"\n  FROM tnr.v_mesures_perf WHERE $__timeFilter(horodatage) AND app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures\n  GROUP BY version_app ORDER BY min(horodatage) DESC"
        }
