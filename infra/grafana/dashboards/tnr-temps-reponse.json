    {
      "id": 6,
      "type": "stat",
      "title": "Dérive vs version précédente",
      "description": "Médiane, sur les mots-clés communs, de l'écart UX p50 entre les 2 dernières versions (toute la période)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH versions AS (\n    SELECT version_app, row_number() OVER (ORDER BY min(horodatage) DESC) AS rang\n    FROM tnr.v_mesures_perf WHERE app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures AND version_app IS NOT NULL\n    GROUP BY version_app\n  ), med AS (\n    SELECT v.rang, m.version_app, m.motcle, percentile_cont(0.5) WITHIN GROUP (ORDER BY m.temps_ux_ms) AS ux\n    FROM tnr.v_mesures_perf m JOIN versions v USING (version_app)\n    WHERE app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures AND v.rang <= 2\n    GROUP BY 1, 2, 3\n  ), comp AS (\n    SELECT a.motcle, b.version_app AS v_prec, a.version_app AS v_act, b.ux AS ux_prec, a.ux AS ux_act\n    FROM med a JOIN med b ON a.motcle = b.motcle AND a.rang = 1 AND b.rang = 2\n  )\n  SELECT round((100 * (percentile_cont(0.5) WITHIN GROUP (ORDER BY ux_act / ux_prec) - 1))::numeric) AS \"Dérive\"\n  FROM comp"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temps par run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
