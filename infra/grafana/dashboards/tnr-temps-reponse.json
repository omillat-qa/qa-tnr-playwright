            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(percentile_cont(0.5) WITHIN GROUP (ORDER BY temps_ux_ms)) AS \"UX p50\"\n  FROM tnr.v_mesures_perf WHERE $__timeFilter(horodatage) AND app = ${app:sqlstring} AND env = ${env:sqlstring} AND machine IN (${machine:sqlstring}) AND motcle IN (${motcle:sqlstring}) AND nb_mesures_run >= $min_mesures"
        }
      ],
