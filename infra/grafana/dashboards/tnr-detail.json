    {
      "id": 6,
      "type": "table",
      "title": "Historique du test",
      "description": "📊 Rapport ouvre le rapport Playwright sur ce test (trace, captures, erreur). Clic sur un run → ses tests.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT horodatage AS \"Date\", statut AS \"Statut\", round(duree_ms / 1000.0, 1) AS \"Durée (s)\", tentative AS \"Retry\",\n         machine AS \"Machine\", projet AS \"Projet\", version_app AS \"Version\", commit_git AS \"Commit\",\n         erreur AS \"Erreur\", run_id AS \"Run\",\n         CASE WHEN rapport_html IS NOT NULL THEN '📊 Rapport' END AS \"Rapport\",\n         rapport_html || coalesce('#?testId=' || pw_id, '') AS lien\n  FROM tnr.v_tests WHERE $__timeFilter(horodatage) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND cle_test = ${test:sqlstring}\n  ORDER BY horodatage DESC LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "passed": {
                        "color": "green",
                        "index": 1
                      },
                      "ko": {
                        "color": "red",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      },
                      "timedOut": {
                        "color": "red",
                        "index": 4
                      },
                      "incomplet": {
                        "color": "orange",
                        "index": 5
                      },
                      "interrupted": {
                        "color": "orange",
                        "index": 6
                      },
                      "non_execute": {
                        "color": "red",
                        "text": "non exécuté",
                        "index": 7
                      },
                      "skipped": {
                        "color": "text",
                        "index": 8
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Détail du run",
                    "targetBlank": false,
                    "url": "/d/tnr-detail/tnr-detail?var-run=${__value.raw:percentencode}&${app:queryparam}&${env:queryparam}&${machine:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rapport"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Rapport Playwright",
                    "targetBlank": true,
                    "url": "${url_rapports}/${__data.fields.lien}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lien"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
