    {
      "id": 3,
      "type": "stat",
      "title": "Réussite",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE statut = 'passed') / nullif(count(*), 0), 1) AS \"Réussite\"\n  FROM tnr.v_tests WHERE $__timeFilter(horodatage) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND cle_test = ${test:sqlstring} AND statut <> 'skipped'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Durée médiane",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
