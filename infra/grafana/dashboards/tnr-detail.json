    {
      "id": 10,
      "type": "table",
      "title": "Tests du run",
      "description": "Échecs en tête. Clic sur un test → son historique ; 📊 Rapport → le test dans le rapport Playwright.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT statut AS \"Statut\", cle_test AS \"Test\", module AS \"Module\", titre AS \"Titre\", projet AS \"Projet\",\n         round(duree_ms / 1000.0, 1) AS \"Durée (s)\", tentative AS \"Retry\", erreur AS \"Erreur\",\n         CASE WHEN rapport_html IS NOT NULL THEN '📊 Rapport' END AS \"Rapport\",\n         rapport_html || coalesce('#?testId=' || pw_id, '') AS lien\n  FROM tnr.v_tests WHERE app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND run_id = ${run:sqlstring}\n  ORDER BY est_echec DESC, est_setup DESC, horodatage"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
