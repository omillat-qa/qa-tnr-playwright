          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(percentile_cont(0.5) WITHIN GROUP (ORDER BY duree_ms)) AS \"Durée médiane\"\n  FROM tnr.v_tests WHERE $__timeFilter(horodatage) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND cle_test = ${test:sqlstring} AND statut = 'passed'"
