        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH t AS (\n    SELECT cle_test, module, app, est_echec, est_flaky,\n           lag(est_echec) OVER (PARTITION BY machine, projet, cle_test ORDER BY horodatage) AS echec_precedent\n    FROM tnr.v_tests\n    WHERE $__timeFilter(horodatage) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND NOT est_setup AND statut <> 'skipped'\n  )\n  SELECT cle_test AS \"Test\", module AS \"Module\", app AS \"App\", count(*) AS \"Exécutions\",\n         count(*) FILTER (WHERE est_flaky) AS \"Flaky (retry)\",\n         count(*) FILTER (WHERE est_echec <> echec_precedent) AS \"Bascules OK/KO\"\n  FROM t GROUP BY 1, 2, 3\n  HAVING count(*) FILTER (WHERE est_flaky) > 0 OR count(*) FILTER (WHERE est_echec <> echec_precedent) >= 2\n  ORDER BY 6 DESC, 5 DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
