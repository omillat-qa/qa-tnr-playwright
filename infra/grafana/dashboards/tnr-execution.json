    {
      "id": 8,
      "type": "table",
      "title": "Derniers runs",
      "description": "Clic sur un run → détail de ses tests ; 📊 Rapport → rapport Playwright (runs depuis le 20/10/2026 14:29)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT debut AS \"Début\", app AS \"App\", env AS \"Env\", projet AS \"Projet\", machine AS \"Machine\",\n         statut AS \"Statut\", passes || ' / ' || total AS \"Passés\", echecs AS \"Échecs\", flaky AS \"Flaky\",\n         non_executes AS \"Non joués\", version_app AS \"Version\", commit_git AS \"Commit\",\n         round(duree_tests_ms / 60000.0, 1) AS \"Durée (min)\", run_id AS \"Run\",\n         CASE WHEN rapport_html IS NOT NULL THEN '📊 Rapport' END AS \"Rapport\",\n         rapport_html AS lien\n  FROM tnr.v_runs WHERE $__timeFilter(debut) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring})\n  ORDER BY debut DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "passed": {
                        "color": "green",
                        "index": 1
                      },
                      "ko": {
                        "color": "red",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      },
                      "timedOut": {
                        "color": "red",
                        "index": 4
                      },
                      "incomplet": {
                        "color": "orange",
                        "index": 5
                      },
                      "interrupted": {
                        "color": "orange",
                        "index": 6
                      },
                      "non_execute": {
                        "color": "red",
                        "text": "non exécuté",
                        "index": 7
                      },
                      "skipped": {
                        "color": "text",
                        "index": 8
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Détail du run",
                    "targetBlank": false,
                    "url": "/d/tnr-detail/tnr-detail?var-run=${__value.raw:percentencode}&${app:queryparam}&${env:queryparam}&${machine:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rapport"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Rapport Playwright",
                    "targetBlank": true,
                    "url": "${url_rapports}/${__data.fields.lien}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lien"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Tests en échec",
      "description": "Clic sur un test → son historique",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT cle_test AS \"Test\", module AS \"Module\", app AS \"App\",\n         count(*) FILTER (WHERE est_echec) AS \"Échecs\", count(*) AS \"Exécutions\",\n         round(100.0 * count(*) FILTER (WHERE est_echec) / count(*), 1) AS \"% échec\",\n         max(horodatage) FILTER (WHERE est_echec) AS \"Dernier échec\",\n         left((array_agg(erreur ORDER BY horodatage DESC) FILTER (WHERE est_echec))[1], 200) AS \"Dernière erreur\"\n  FROM tnr.v_tests\n  WHERE $__timeFilter(horodatage) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring}) AND NOT est_setup AND statut <> 'skipped'\n  GROUP BY 1, 2, 3 HAVING count(*) FILTER (WHERE est_echec) > 0\n  ORDER BY 4 DESC, 7 DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Test"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Historique du test",
                    "targetBlank": false,
                    "url": "/d/tnr-detail/tnr-detail?var-test=${__value.raw:percentencode}&${app:queryparam}&${env:queryparam}&${machine:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Tests instables",
      "description": "Flaky = passé après retry. Bascule = statut différent du run précédent (même machine, même projet). Seuil : 2 bascules. Clic sur un test → son historique.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
