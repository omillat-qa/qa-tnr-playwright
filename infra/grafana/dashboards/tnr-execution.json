          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE statut IN ('ko', 'incomplet', 'non_execute')) AS \"Projets non OK\"\n  FROM tnr.v_runs WHERE $__timeFilter(debut) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring})"
