  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tnr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
