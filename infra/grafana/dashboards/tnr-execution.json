            "uid": "tnr-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(DISTINCT (run_id, machine)) AS \"Runs\"\n  FROM tnr.v_runs WHERE $__timeFilter(debut) AND app IN (${app:sqlstring}) AND env IN (${env:sqlstring}) AND machine IN (${machine:sqlstring})"
