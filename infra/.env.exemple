# infra/.env.exemple — à copier en infra/.env (jamais commité) puis renseigner
# Les mots de passe des comptes tnr_* ne sont pris en compte qu'à la création de la base
# (premier « docker compose up », volume pgdata vide). Ensuite : ALTER ROLE … PASSWORD …

# Superutilisateur PostgreSQL (administration uniquement)
POSTGRES_PASSWORD=

# tnr_ecriture : import des JSONL (PG_USER / PG_PASSWORD dans .env.local des VM qui importent)
TNR_RW_PASSWORD=

# tnr_lecture : datasource Grafana, requêtes ad hoc (lecture seule)
TNR_RO_PASSWORD=

# Compte admin Grafana
GF_ADMIN_PASSWORD=

# Adresse publique de Grafana (défaut http://localhost:3000) — à définir sur un serveur partagé
# GF_ROOT_URL=http://serveur.int.dns:3000
